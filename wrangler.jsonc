{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "company-brain-cvc",
	"main": "src/worker.ts",
	"compatibility_date": "2025-06-22",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env",
		"enable_ctx_exports"
	],
	"minify": true,
	"build": {
		"command": "bun run build:web",
		"watch_dir": ["src", "web"]
	},
	"assets": {
		"directory": "./dist/web",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/brain/*",
			"/slack/*",
			"/auth/*",
			"/setup",
			"/setup/*",
			"/health"
		]
	},
	"vars": {
		// "on" once the Workers Paid block below is enabled: sandbox tools then
		// run on a Cloudflare container.
		"CONTAINER_SANDBOX": "on",
		// The sandbox SDK's RPC transport; artifact downloads stream over it.
		"SANDBOX_TRANSPORT": "rpc",
		// Private Slack channels that may use org-shared MCP tools, comma-separated.
		"SHARED_MCP_CHANNELS": "C0CF6LJUHGR,C0CG8STQNSK",
		// Private Slack channels the bot may learn from without being mentioned.
		"LEARNING_CHANNELS": "C08M0F5R50W,C056FDJMHM4",
		// "on": no DMs, no automatic team invites, no automatic channel joins.
		"PILOT_LOCKDOWN": "on",
		// Private channels learned through the Nexus AI bot into team-wide memory. Token: secret NEXUS_BOT_TOKEN.
		"MEMORY_REVIEW_CHANNEL": "C0CF6LJUHGR",
		"NEXUS_LEARNING_CHANNELS": "C0ACY9QB73N,C08EK1RBJFK,C09QKTCQBNE,C04LLJ8CBB5,C0AP639DL30,C0817CX8WMV,C034198K1V3,C034FQ4CYKT,C034UFUGYAC,C041JQ048JV,C04S4U3PZUZ,C0550GGS84Q,C05HZTGJ7UP,C06LC4XL9TN,C06UW2ZMJNA,C070TH6BS6P,C072A6G34F2,C077J19J2RL,C07BK56RC8J,C07GKQZAMS5,C07LHANLGS2,C07NSHJBU0N,C07PE2052TS,C07SAT9PEPR,C080NLPA9S7,C083YSUE5QS,C089WGQ5718,C08AYS4EMGA,C08C3L56P7Z,C08EA0XE2UU,C08K39GGAR2,C08K8UPJVS7,C08PE6AKA4A,C08RSR2HLJV,C08SY5M481M,C08VB9U6ET0,C091YEG9RS6,C093F6PC680,C094700A5GX,C096CA9S6DB,C099WG116BB,C09ACV91A3Y,C09B54C8CNN,C09BZ1Q94G5,C09ETLN49EK,C09GU8FP6KU,C09KFDCPCR3,C09LSTJJZ3Q,C09MD0T13RU,C09QGJHTWF2,C09QRSZ4PL4,C09R6LZP2JC,C09RA7ERN0M,C09TKJKB570,C09TR7EH012,C09TRS8L45T,C09UJB767J8,C0A1VQJGF8R,C0A29LQ4AUD,C0A3E1N3T9D,C0A48FSFG69,C0A4L7R45HQ,C0A6L5ME0CF,C0A81N16XDW,C0A8C54ABQA,C0A8HLR65H9,C0A9VRWP9QR,C0AA1LYN98T,C0AABLWPGNQ,C0AAR6CHWRH,C0AAV1QEVLG,C0ABGEY73UP,C0ABW4NB3GE,C0AC5GU4CNB,C0AC9T383CZ,C0ACD9J1Z71,C0ADJ56DKMF,C0AESFC4X6E,C0AFA7A7H8V,C0AFDKUB0CS,C0AFJQ0BM38,C0AFKU9NW3T,C0AG7QNH673,C0AGKEH3XN3,C0AJHDRQB6K,C0AJWJF8NQP,C0AKGBC4BK6,C0ALVDXVDSQ,C0ANKMAQQQ5,C0APHBY880P,C0ATF4QNV0D,C0B3KHJMZR9,C0B3T0Z4N91,C0B482W76UB,C0B4KDQ401M,C0B66BEDC1Z,C0B9147BC4U,C0BB0107SA3,C0BBK01AR2M,C0BEGLJ2SGK,C0BF4LCGEPR,C0BFJ6B58KY,C0126BTMW80",
		// Learn only posts containing this text (and their threads) in these channels: "CHANNEL=text;CHANNEL=text".
		"NEXUS_CHANNEL_FILTERS": "C0126BTMW80=Sentiment Watch",
		// MCP servers we run and know are read-only.
		"READ_ONLY_MCP_SERVERS": "companybrainmcp,social-media-mcp"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "company-brain",
			"database_id": "3de50521-8aed-490c-9b9f-a49d56db56c0",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "BRAIN_KV",
			"id": "360211df96a6480d92696c4bf5b1c3a8"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "COMPANY_BRAIN_AGENT",
				"class_name": "CompanyBrainAgent"
			},
			{
				"name": "Sandbox",
				"class_name": "Sandbox"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CompanyBrainAgent"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Sandbox"
			]
		}
	],
	// ── Workers Paid ($5/mo) ─────────────────────────────────────────────────
	// The brain runs on the free plan. On Workers Paid, uncomment this block
	// and set CONTAINER_SANDBOX to "on" above to give it a built-in container
	// sandbox (shell, git, Python). Without it, sandbox tools use Daytona when
	// DAYTONA_API_KEY is set.
	//
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./sandbox/Dockerfile",
			"instance_type": "basic",
			"max_instances": 20
		}
	],
	"unsafe": {
		"bindings": [
			{
				"type": "ratelimit",
				"name": "GMAIL_FETCH_RATE_LIMITER",
				"namespace_id": "1101",
				"simple": {
					"limit": 150,
					"period": 10
				}
			},
			{
				"type": "ratelimit",
				"name": "GRANOLA_FETCH_RATE_LIMITER",
				"namespace_id": "1102",
				"simple": {
					"limit": 25,
					"period": 10
				}
			}
		]
	}
}
